# MongoDB Connection URI
MONGO_URI=mongodb://localhost:27017/

# Database Name
DB_NAME=respiratory_screening

# Audio Uploads Storage Directory (defaults to backend/app/storage/uploads)
UPLOAD_DIR=app/storage/uploads

# Quality Abstention Threshold (scores < 0.35 are rejected for safety)
Q_ABSTAIN_TIER1=0.35

# FastAPI Server Port
PORT=8000
